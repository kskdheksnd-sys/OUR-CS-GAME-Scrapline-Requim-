   if(w.style==='pellets'){for(let i=0;i<w.pellets;i++)shot(p.aim+(i/(w.pellets-1)-.5)*w.spread+rand(-.04,.04),900,3.5,'#ffe08a');}
   else if(w.style==='twin'){for(const sd of[-1,1])shot(p.aim,950,4,'#9fe8ff',{x:mx-ay*7*sd,y:my+ax*7*sd});}
