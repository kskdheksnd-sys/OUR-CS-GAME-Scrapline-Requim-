 rook:{name:'Rook',hp:1400,atk:170,ability:'Sentry Turret',items:['repairKit'],cap:5,scrap:0,color:'#4fb36a',cd:16,desc:'Deploys an auto-turret at your cursor for 12 seconds. It shoots the nearest machine. Up to two at once. Starts with a Repair Kit.'},
