   else if(w.style==='cryo')shot(p.aim,720,8,'#7fdcff',{slow:true});
   else if(w.style==='ricochet')shot(p.aim,800,5,'#ffd34d',{bounce:w.o.bounce,life:w.range*w.o.lifeMul/800});
   else if(w.style==='boomerang')shot(p.aim,620,10,'#cfd8de',{pierce:true,boom:true,life:w.range*2/620,turn:w.range/620});
