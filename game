  const p=G.p;
  for(const u of G.turrets){
    ctx.save();ctx.translate(u.x,u.y);ctx.fillStyle='#1b232a';ctx.strokeStyle=p.color;ctx.lineWidth=2;ctx.fillRect(-11,-11,22,22);ctx.strokeRect(-11,-11,22,22);
    ctx.rotate(u.a);ctx.strokeStyle=p.color+'44';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(19,0);ctx.lineTo(150,0);ctx.stroke();ctx.fillStyle=p.color;ctx.fillRect(2,-3,17,6);
    if(u.cd>.3){ctx.fillStyle='rgba(255,240,170,.9)';ctx.beginPath();ctx.arc(22,0,6*(u.cd-.3)/.15,0,7);ctx.fill();}ctx.restore();
    ctx.strokeStyle=p.color;ctx.lineWidth=2;ctx.beginPath();ctx.arc(u.x,u.y,17,-1.5708,-1.5708+6.2832*clamp(u.t/u.max,0,1));ctx.stroke();
  }
  for(const u of G.eTurrets){
    ctx.save();ctx.translate(u.x,u.y);ctx.fillStyle='#1b232a';ctx.strokeStyle='#ff5a3c';ctx.lineWidth=2;ctx.fillRect(-11,-11,22,22);ctx.strokeRect(-11,-11,22,22);
    ctx.rotate(u.a);ctx.fillStyle='#ff5a3c';ctx.fillRect(2,-3,17,6);ctx.restore();
    ctx.strokeStyle='#ff5a3c';ctx.lineWidth=2;ctx.beginPath();ctx.arc(u.x,u.y,17,-1.5708,-1.5708+6.2832*clamp(u.t/u.max,0,1));ctx.stroke();
  }
  for(const g of G.grenades){
    const k=clamp(g.t/g.dur,0,1),h=Math.sin(k*Math.PI)*46;
    ctx.fillStyle='rgba(0,0,0,.35)';ctx.beginPath();ctx.ellipse(g.x,g.y+4,6,3,0,0,7);ctx.fill();
    ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(g.x,g.y-h,6,0,7);ctx.fill();ctx.strokeStyle='#0b0e10';ctx.lineWidth=2;ctx.stroke();
    ctx.strokeStyle='rgba(255,255,255,.25)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(g.tx,g.ty,130,0,7);ctx.stroke();
  }
}
function drawZones(t){
  for(const z of G.zones){
    const fade=clamp(z.t/.6,0,1);ctx.save();ctx.globalAlpha=fade;
    if(z.k==='smoke'||z.k==='esmoke'){
      ctx.globalAlpha=.86*fade;
      for(let i=0;i<14;i++){const a=i*.9+t*(i%2?.3:-.25),rr=z.r*(.2+.4*((i*.37)%1));ctx.fillStyle=['#5c6770','#6d7984','#4d575f'][i%3];ctx.beginPath();ctx.arc(z.x+Math.cos(a)*rr,z.y+Math.sin(a)*rr,z.r*(.36+.1*Math.sin(t*1.5+i)),0,7);ctx.fill();}
      ctx.globalAlpha=.9*fade;ctx.strokeStyle=z.k==='esmoke'?'rgba(255,90,60,.6)':'rgba(190,200,210,.45)';ctx.lineWidth=2;ctx.setLineDash([10,8]);ctx.beginPath();ctx.arc(z.x,z.y,z.r,t*.4,t*.4+6.28);ctx.stroke();ctx.setLineDash([]);
    }else if(z.k==='heal'||z.k==='eheal'){
      {const g=ctx.createRadialGradient(z.x,z.y,4,z.x,z.y,z.r);g.addColorStop(0,'rgba(114,210,131,.35)');g.addColorStop(1,'rgba(114,210,131,.08)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(z.x,z.y,z.r,0,7);ctx.fill();}
      for(let i=0;i<3;i++){const pr=(t*.5+i/3)%1;ctx.strokeStyle='rgba(160,255,180,'+(.55*(1-pr))+')';ctx.lineWidth=2;ctx.beginPath();ctx.arc(z.x,z.y,z.r*pr,0,7);ctx.stroke();}
      ctx.strokeStyle='rgba(114,210,131,.75)';ctx.lineWidth=2;ctx.setLineDash([6,6]);ctx.beginPath();ctx.arc(z.x,z.y,z.r,t,t+6.28);ctx.stroke();ctx.setLineDash([]);
      for(let i=0;i<5;i++){const a=i*1.256+t*.8,r=z.r*(.3+.5*((t*.6+i*.37)%1));ctx.fillStyle='#72d283';const x=z.x+Math.cos(a)*r,y=z.y+Math.sin(a)*r;ctx.fillRect(x-1.5,y-5,3,10);ctx.fillRect(x-5,y-1.5,10,3);}
    }else{
      for(let i=0;i<=22;i++){const k=i/22,x=z.x1+(z.x2-z.x1)*k,y=z.y1+(z.y2-z.y1)*k,fl=Math.sin(t*14+i*1.7),hh=28+10*fl+6*Math.sin(t*23+i);ctx.fillStyle='rgba(255,110,40,.22)';ctx.beginPath();ctx.arc(x,y,20,0,7);ctx.fill();
        for(const [c,sz] of[['#d9381e',1],['#ff8a2e',.7],['#ffe27a',.4]]){ctx.fillStyle=c;ctx.beginPath();ctx.moveTo(x-12*sz,y+4);ctx.quadraticCurveTo(x-10*sz,y-hh*.5,x+fl*3,y-hh*sz);ctx.quadraticCurveTo(x+10*sz,y-hh*.5,x+12*sz,y+4);ctx.closePath();ctx.fill();}}
    }
    ctx.restore();
  }
}
function drawFx(){
  for(const f of G.fx){
    const k=f.t/f.max;ctx.save();ctx.globalAlpha=k;
    if(f.k==='swing'||f.k==='cone'){const half=f.half||(f.k==='cone'?1.1:1.2);ctx.fillStyle=f.col;ctx.globalAlpha=k*(f.k==='cone'?.35:.5);ctx.beginPath();ctx.moveTo(f.x,f.y);ctx.arc(f.x,f.y,f.r*(f.k==='cone'?1-k*.2:.85+.15*(1-k)),f.a-half,f.a+half);ctx.closePath();ctx.fill();}
    else if(f.k==='ring'){ctx.strokeStyle=f.col;ctx.lineWidth=5*k+1;ctx.beginPath();ctx.arc(f.x,f.y,f.r*(1-k*k),0,7);ctx.stroke();}
    else if(f.k==='slam'){ctx.strokeStyle='#ff8a3c';ctx.lineWidth=8*k+1;ctx.beginPath();ctx.arc(f.x,f.y,f.r*(1.05-.2*k),0,7);ctx.stroke();}
    else if(f.k==='pillar'){const w=60*k;ctx.globalAlpha=.6*k;ctx.fillStyle=f.col||'#ff3c50';ctx.fillRect(f.x-w/2,f.y-320,w,320);ctx.globalAlpha=k;ctx.fillStyle='#fff';ctx.fillRect(f.x-w/6,f.y-320,w/3,320);}
    else if(f.k==='arc'){const pr=1-k;ctx.strokeStyle=f.col;ctx.lineWidth=7*k+1;ctx.beginPath();ctx.arc(f.x,f.y,f.r*(.35+.65*pr),f.a-f.half,f.a+f.half);ctx.stroke();ctx.strokeStyle='#fff';ctx.lineWidth=2*k;ctx.beginPath();ctx.arc(f.x,f.y,f.r*(.2+.6*pr),f.a-f.half*.9,f.a+f.half*.9);ctx.stroke();}
    else if(f.k==='emp'){const pr=1-k;for(let i=0;i<3;i++){const q=clamp(pr*1.4-i*.18,0,1);if(q<=0)continue;ctx.globalAlpha=k*(1-q*.5);ctx.strokeStyle=i?f.col:'#fff';ctx.lineWidth=4*(1-q)+1;ctx.beginPath();ctx.arc(f.x,f.y,f.r*q,0,7);ctx.stroke();}
     ctx.globalAlpha=k;ctx.strokeStyle='#e8f6ff';ctx.lineWidth=1.5;for(let i=0;i<9;i++){const a=i*.698+pr*2;let x=f.x,y=f.y;ctx.beginPath();ctx.moveTo(x,y);for(let j=1;j<=6;j++){const rr=f.r*pr*j/6;x=f.x+Math.cos(a+rand(-.12,.12))*rr;y=f.y+Math.sin(a+rand(-.12,.12))*rr;ctx.lineTo(x,y);}ctx.stroke();}}
    else if(f.k==='slash'){ctx.strokeStyle=f.col;ctx.lineWidth=3*k+1;const c=Math.cos(f.a+.8),n=Math.sin(f.a+.8);for(let i=-1;i<=1;i++){ctx.beginPath();ctx.moveTo(f.x-c*26+i*7,f.y-n*26+i*5);ctx.lineTo(f.x+c*26+i*7,f.y+n*26+i*5);ctx.stroke();}}
    else if(f.k==='blast'){ctx.fillStyle='rgba(255,170,70,.35)';ctx.beginPath();ctx.arc(f.x,f.y,f.r*(1-k*.3),0,7);ctx.fill();ctx.fillStyle='rgba(255,255,255,'+(.7*k*k*k)+')';ctx.beginPath();ctx.arc(f.x,f.y,f.r*.55*k+8,0,7);ctx.fill();ctx.strokeStyle='#ffb14d';ctx.lineWidth=4*k+1;ctx.beginPath();ctx.arc(f.x,f.y,f.r*(1.15-.15*k),0,7);ctx.stroke();ctx.lineWidth=4*k+1;ctx.beginPath();ctx.arc(f.x,f.y,f.r,0,7);ctx.stroke();}
    else if(f.k==='line'){ctx.strokeStyle=f.col;ctx.lineWidth=6*k+1;ctx.beginPath();ctx.moveTo(f.x,f.y);ctx.lineTo(f.x2,f.y2);ctx.stroke();}
    ctx.restore();
  }
  for(const b of G.bullets){
    if(b.crescent){ctx.save();ctx.translate(b.x,b.y);ctx.rotate(Math.atan2(b.vy,b.vx));ctx.globalAlpha=.25;ctx.fillStyle=b.col;ctx.beginPath();ctx.arc(0,0,b.r*2.2,0,7);ctx.fill();ctx.globalAlpha=1;ctx.lineCap='round';ctx.strokeStyle=b.col;ctx.lineWidth=14;ctx.beginPath();ctx.arc(-b.r*1.2,0,b.r*2.2,-1.05,1.05);ctx.stroke();ctx.strokeStyle='#fff';ctx.lineWidth=5;ctx.beginPath();ctx.arc(-b.r*1.2,0,b.r*2.2,-1,1);ctx.stroke();ctx.lineCap='butt';ctx.restore();continue;}
    ctx.fillStyle=b.col+'55';ctx.beginPath();ctx.arc(b.x,b.y,b.r*2,0,7);ctx.fill();
    ctx.fillStyle=b.col;ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,7);ctx.fill();
  }
  for(const q of G.parts){ctx.globalAlpha=clamp(q.t/q.max,0,1);ctx.fillStyle=q.col;ctx.fillRect(q.x-q.size/2,q.y-q.size/2,q.size,q.size);}
  ctx.globalAlpha=1;
  for(const f of G.floats){ctx.globalAlpha=clamp(f.t/.5,0,1);txt(f.text,f.x,f.y,f.size,f.color,'center',MONO,700);}
  ctx.globalAlpha=1;
}

/* ---------- rendering: HUD + frame ---------- */
function itemIcon(it,cx,cy){
  if(it.effectType==='Heal'){ctx.fillStyle='#ff6b5a';ctx.fillRect(cx-3,cy-9,6,18);ctx.fillRect(cx-9,cy-3,18,6);}
  else if(it.effectType==='Shield'){ctx.save();ctx.translate(cx,cy);ctx.fillStyle='#4fd1c5';poly(6,10,0);ctx.fill();ctx.fillStyle='#10151a';poly(6,4,0);ctx.fill();ctx.restore();}
  else{ctx.fillStyle='#f2b02e';ctx.beginPath();ctx.arc(cx,cy,9,0,7);ctx.fill();ctx.fillStyle='#10151a';ctx.beginPath();ctx.arc(cx,cy,3.5,0,7);ctx.fill();}
}
const STAT={'Attack':'ATK','Speed':'SPD','Max HP':'HP'};
function drawHUD(){
  const p=G.p,room=G.room,inv=p.inventory;
  // top bar
  ctx.fillStyle='#10151a';ctx.fillRect(0,0,W,AR.y1);ctx.fillStyle='#2b3640';ctx.fillRect(0,AR.y1-1,W,1);
  txt('HP',24,26,11,'#92a0aa');bar(52,12,290,18,p.hp/p.maxHp,'#e8574a');
  txt(p.hp+' / '+p.maxHp,197,25,11,'#fff','center',MONO,600);
  txt('SH',24,48,11,'#92a0aa');bar(52,36,290,10,p.shield/p.shieldMax,'#4fd1c5');
  txt(String(p.shield),350,46,10,'#92a0aa');
  txt('ROOM '+(G.roomIdx+1)+' / '+G.rooms.length,W/2,22,11,'#f2b02e','center',MONO,600);
  txt(room.name.toUpperCase(),W/2,50,24,'#dde4e8','center',DISP,800);
  for(let i=0;i<5;i++){ctx.fillStyle=i<room.dangerLevel?'#ff5a3c':'#2b3640';ctx.fillRect(W/2+82+i*9,40,6,10);}
  const alive=room.enemies.filter(m=>!m.isDead()).length;
  txt('SCRAP',W-24,24,11,'#92a0aa','right');txt(String(inv.scrap),W-80,25,15,'#f2b02e','right',MONO,600);
  txt('HOSTILES',W-24,48,11,'#92a0aa','right');txt(String(alive),W-100,49,15,alive?'#ff5a3c':'#72d283','right',MONO,600);
  // bottom bar
  ctx.fillStyle='#10151a';ctx.fillRect(0,AR.y2,W,H-AR.y2);ctx.fillStyle='#2b3640';ctx.fillRect(0,AR.y2,W,1);
  for(let i=0;i<inv.capacity;i++){
    const x=24+i*44,y=548,sel=i===p.selected;
    ctx.fillStyle='#0b0f12';ctx.fillRect(x,y,40,40);ctx.strokeStyle=sel?'#f2b02e':'#2b3640';ctx.lineWidth=sel?2:1;ctx.strokeRect(x+.5,y+.5,39,39);
    if(inv.items[i])itemIcon(inv.items[i],x+20,y+22);
    txt(String(i+1),x+4,y+11,9,sel?'#f2b02e':'#6b7983');
  }
  const sel=inv.items[p.selected];
  txt(sel?'Q: '+sel.name:'Pack empty',24,592,10,'#92a0aa');
  const w=p.weapon,rc=RARITY[w.rarity];
  if(p.weapon2)txt('[F] '+p.weapon2.name.toUpperCase(),300,547,10,RARITY[p.weapon2.rarity],'left',MONO,600);else txt('[F] 2nd weapon slot empty',300,547,10,'#6b7983');
  txt(w.name.toUpperCase(),300,568,20,rc,'left',DISP,800);
  txt(w.type+' · '+w.rarity+(w.o.tag?' · '+w.o.tag:''),300,582,10,'#92a0aa');
  txt('DMG '+w.calculateDamage(p)+(w.pellets>1?' x'+w.pellets:'')+' · RNG '+w.range,300,594,10,'#dde4e8');
  let cx=512;
  for(const q of G.powers){
    ctx.fillStyle='#1b232a';ctx.fillRect(cx,550,64,36);ctx.strokeStyle='#44525e';ctx.lineWidth=1;ctx.strokeRect(cx+.5,550.5,63,35);
    txt(STAT[q.pu.affectedStat]+' +'+q.pu.bonus,cx+32,565,11,'#72d283','center',MONO,600);
    txt(q.left+' room'+(q.left>1?'s':''),cx+32,579,9,'#92a0aa','center');cx+=68;
  }
  // ability + dodge
  const ar=1-p.abilityCd/p.abilityMax;
  ctx.fillStyle='#1b232a';ctx.fillRect(724,548,102,44);ctx.strokeStyle=p.abilityCd<=0?p.color:'#2b3640';ctx.lineWidth=p.abilityCd<=0?2:1;ctx.strokeRect(724.5,548.5,101,43);
  txt('RMB '+p.ability.toUpperCase(),775,562,9,'#dde4e8','center',MONO,600);
  bar(732,570,86,8,ar,p.color);txt(p.abilityCd<=0?'READY':p.abilityCd.toFixed(1)+'s',775,587,9,p.abilityCd<=0?p.color:'#92a0aa','center');
  const dr=1-p.dashCd/.9;
  ctx.fillStyle='#1b232a';ctx.fillRect(836,548,100,44);ctx.strokeStyle='#2b3640';ctx.lineWidth=1;ctx.strokeRect(836.5,548.5,99,43);
  txt('SPACE DODGE',886,562,9,'#dde4e8','center',MONO,600);
  bar(844,570,84,8,dr,'#9fe8ff');txt(p.dashCd<=0?'READY':p.dashCd.toFixed(1)+'s',886,587,9,p.dashCd<=0?'#9fe8ff':'#92a0aa','center');
  // boss bar
  const boss=room.enemies.find(m=>m.boss&&!m.isDead()&&m.spawnT<=0);
  if(boss){bar(280,76,400,12,boss.hp/boss.maxHp,'#ff5a3c');for(let q=.1;q<.95;q+=.1){ctx.fillStyle='#0b0f12';ctx.fillRect(280+400*q-1,76,2,12);}
    txt('DEMOLISHER - STAGE '+(boss.stage||1)+' / 10'+(boss.stage===10?' - FINAL':'')+(boss.bk?' - BANKAI '+ROM[boss.bt-1]:''),W/2,106,12,'#ff8a6c','center',MONO,600);}
  // toasts
  G.toasts.forEach((t,i)=>{ctx.globalAlpha=clamp(t.t,0,1);txt(t.text,W/2,boss?128+i*20:104+i*20,13,t.color,'center',MONO,500);});ctx.globalAlpha=1;
  // prompt
  if(G.prompt){const wd=ctx.measureText(G.prompt).width+28;ctx.fillStyle='rgba(11,14,16,.85)';ctx.fillRect(W/2-wd/2,500,wd,26);ctx.strokeStyle='#f2b02e';ctx.lineWidth=1;ctx.strokeRect(W/2-wd/2+.5,500.5,wd-1,25);txt(G.prompt,W/2,518,13,'#f2b02e','center',MONO,600);}
