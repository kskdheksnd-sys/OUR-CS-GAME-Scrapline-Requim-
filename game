   else if(w.style==='buzz')shot(p.aim,520,12,'#cfd8de',{pierce:true,bounce:w.o.bounce,life:2.2});
   else if(w.style==='fan'){for(let i=0;i<5;i++)shot(p.aim+(i/4-.5)*.7,700,6,'#7fdcff',{pierce:true});}
   else if(w.style==='singularity')shot(p.aim,260,12,'#b790ff',{pierce:true,noHit:true,pull:true,explode:w.radius});
   else if(w.style==='sniper')shot(p.aim,1600,5,'#ffffff',{pierce:true});
   else if(w.style==='launcher')shot(p.aim,560,8,'#ff9a4d',{explode:w.radius});
   else if(w.style==='chain')shot(p.aim,800,6,'#8ab6ff',{chain:true});
   else if(w.style==='plasma')shot(p.aim,720,9,'#ffb02e',{pierce:true});
   else shot(p.aim,950,4,'#9fe8ff');
   G.burst(mx,my,3,'#ffd9a0',120,.15,2);sfx('shoot');
  }
 },
 tickPowers(){
  for(const q of G.powers){q.left--;if(q.left<=0){q.pu.remove(G.p);G.toast(q.pu.name+' expired','#92a0aa');}}
  G.powers=G.powers.filter(q=>q.left>0);
 },
 interact(){
  const p=G.p;if(G.state!=='play')return;
  {const pk=G.nearPickup();if(pk){if(!p.weapon2){p.weapon2=p.weapon;p.equipWeapon(pk.weapon);G.pickups=G.pickups.filter(q=>q!==pk);G.toast('Equipped '+pk.weapon.name+' (F swaps weapons)',RARITY[pk.weapon.rarity]);sfx('pickup');return;}const old=p.weapon;p.equipWeapon(pk.weapon);G.toast('Equipped '+pk.weapon.name+' ('+pk.weapon.rarity+')',RARITY[pk.weapon.rarity]);pk.weapon=old;sfx('pickup');return;}}
  if(!G.cleared)return;
  if(G.roomIdx<G.rooms.length-1){if(dist(p,DOOR)<95){G.state='trans';G.trans={t:0,phase:'out'};sfx('door');}}
  else if(G.terminal&&dist(p,G.terminal)<75){G.state='won';G.endT=1.6;G.flash=1;G.burst(G.terminal.x,G.terminal.y,60,'#72d283',320,1,4);sfx('clear');}
 },
 useSelected(){
  const p=G.p,it=p.inventory.items[p.selected];if(G.state!=='play'||!it)return;
  if(it.effectType==='Heal'&&p.hp>=p.maxHp){G.toast('HP is already full');return;}
  if(it.effectType==='Shield'&&p.shield>=p.shieldMax){G.toast('Shield is already full');return;}
  p.useItem(it);p.selected=clamp(p.selected,0,Math.max(0,p.inventory.items.length-1));
  G.toast('Used '+it.name,'#72d283');G.burst(p.x,p.y,10,'#72d283',120,.5);sfx('pickup');
 },
 dash(){
  const p=G.p,k=G.keys;if(G.state!=='play'||p.dashCd>0)return;
  let dx=(k.KeyD?1:0)-(k.KeyA?1:0),dy=(k.KeyS?1:0)-(k.KeyW?1:0);
  if(!dx&&!dy){dx=Math.cos(p.aim);dy=Math.sin(p.aim);}
  const l=Math.hypot(dx,dy);p.dashX=dx/l;p.dashY=dy/l;p.dashT=.2;p.dashCd=.9;sfx('dash');
 },

 update(dt){
  if(G.bk&&G.state==='play'){G.bk.t+=dt;G.bkTick(dt);dt*=G.bk?.2:1;}
  const p=G.p,k=G.keys,room=G.room;
  G.shake=Math.max(0,G.shake-dt*30);G.flash=Math.max(0,G.flash-dt*1.5);
  for(const f of G.fx)f.t-=dt;G.fx=G.fx.filter(f=>f.t>0);
  for(const q of G.parts){q.x+=q.vx*dt;q.y+=q.vy*dt;q.vx*=.93;q.vy*=.93;q.t-=dt;}G.parts=G.parts.filter(q=>q.t>0);
  for(const f of G.floats){f.y-=34*dt;f.t-=dt;}G.floats=G.floats.filter(f=>f.t>0);
  for(const t of G.toasts)t.t-=dt;G.toasts=G.toasts.filter(t=>t.t>0);
  if(G.card>0)G.card-=dt;
  if(G.state==='trans'){
   G.trans.t+=dt/.35;
   if(G.trans.t>=1){if(G.trans.phase==='out'){G.loadRoom(G.roomIdx+1);G.trans={t:0,phase:'in'};}else{G.trans=null;G.state='play';}}
   return;
  }
  if(G.state==='dead'||G.state==='won'){G.endT-=dt;if(G.endT<=0)G.showEnd();return;}
  if(G.state!=='play')return;
  G.time+=dt;
  // player
  p.aim=Math.atan2(G.mouse.y-p.y,G.mouse.x-p.x);
  for(const n of['atkCd','abilityCd','dashCd','iframes','rapidT','hurtT'])p[n]=Math.max(0,p[n]-dt);
  if(p.dashT>0){
   p.dashT-=dt;step(p,p.dashX*720,p.dashY*720,dt);
   G.parts.push({x:p.x,y:p.y,vx:0,vy:0,t:.25,max:.25,col:p.color,size:9});
  }else{
   let dx=(k.KeyD?1:0)-(k.KeyA?1:0),dy=(k.KeyS?1:0)-(k.KeyW?1:0);const l=Math.hypot(dx,dy);
   if(l){const sp=(p.speed+p.speedBonus)*U;step(p,dx/l*sp,dy/l*sp,dt);}
  }
  if(p.rapidT>0&&Math.random()<.7)G.parts.push({x:p.x+rand(-14,14),y:p.y+rand(-14,14),vx:rand(-60,60),vy:rand(-100,-20),t:.4,max:.4,col:Math.random()<.5?'#fff':p.color,size:3});
  if(G.mouse.left&&p.atkCd<=0&&p.dashT<=0)G.fire();
  // machines
  for(const m of room.enemies)m.update(dt);
  // zones, turrets, grenades, delayed effects
  for(const z of G.zones){
   z.t-=dt;
   if(z.k==='heal'&&Math.hypot(p.x-z.x,p.y-z.y)<z.r){p.heal(150*dt);if(Math.random()<.5)G.parts.push({x:p.x+rand(-12,12),y:p.y+rand(-6,12),vx:0,vy:-60,t:.6,max:.6,col:'#72d283',size:4});z.tick-=dt;if(z.tick<=0){z.tick=.5;G.float(p.x,p.y-26,'+75','#72d283',12);}}
   if(z.k==='fire'||z.k==='efire'){if(Math.random()<.6){const q=Math.random();G.parts.push({x:z.x1+(z.x2-z.x1)*q,y:z.y1+(z.y2-z.y1)*q,vx:rand(-20,20),vy:rand(-130,-50),t:.7,max:.7,col:Math.random()<.5?'#ffb14d':'#ff5a3c',size:3});}}
   if(z.k==='eheal'){for(const m of room.enemies){if(m.isDead()||m.spawnT>0||Math.hypot(m.x-z.x,m.y-z.y)>z.r+m.r)continue;m.hp=Math.min(m.maxHp,m.hp+m.maxHp*.07*dt);}}
   if(z.k==='efire'){z.tick-=dt;if(z.tick<=0){z.tick=.25;if(segDist(p.x,p.y,z)<z.w+p.r)G.hurtPlayer(z.d);}}
   if(z.k==='fire'){z.tick-=dt;if(z.tick<=0){z.tick=.25;const d=Math.round(p.atk*1.3*.25);for(const m of room.enemies){if(m.isDead()||m.spawnT>0||segDist(m.x,m.y,z)>z.w+m.r)continue;m.takeDamage(d);G.afterHit(m,d,0,0);}}}
  }
  G.zones=G.zones.filter(z=>z.t>0);
  for(const u of G.turrets){
   u.t-=dt;u.cd-=dt;
   let best=null,bd=460;
   for(const m of room.enemies){if(m.isDead()||m.spawnT>0)continue;const d=Math.hypot(m.x-u.x,m.y-u.y);if(d<bd){bd=d;best=m;}}
   if(best){u.a=Math.atan2(best.y-u.y,best.x-u.x);if(u.cd<=0){u.cd=.45;G.bullets.push({x:u.x,y:u.y,vx:Math.cos(u.a)*900,vy:Math.sin(u.a)*900,r:4,dmg:Math.round(p.atk*.9),friendly:true,life:.6,col:'#9affb0',pierce:false,hit:new Set()});sfx('shoot');}}
  }
  G.turrets=G.turrets.filter(u=>u.t>0);
  for(const u of G.eTurrets){u.t-=dt;u.cd-=dt;if(u.owner.isDead())u.t=0;if(u.cd<=0&&u.t>0){u.a=Math.atan2(p.y-u.y,p.x-u.x);G.fireBolt(u.x,u.y,u.a,300,Math.round(u.owner.atk*.4),5,'#ff5a3c');u.cd=1;}}
  G.eTurrets=G.eTurrets.filter(u=>u.t>0);
  for(const g of G.grenades){
   g.t+=dt;G.parts.push({x:g.x,y:g.y-Math.sin(Math.min(1,g.t/g.dur)*Math.PI)*46,vx:0,vy:0,t:.35,max:.35,col:'#9aa4ac',size:5});const k=Math.min(1,g.t/g.dur);g.x=g.x0+(g.tx-g.x0)*k;g.y=g.y0+(g.ty-g.y0)*k;
   if(g.t>=g.dur){
    g.done=true;G.explode(g.tx,g.ty,130,g.dmg*3,700);
    for(let i=0;i<4;i++){const a=Math.random()*6.283,r=rand(60,110),bx=clamp(g.tx+Math.cos(a)*r,AR.x1,AR.x2),by=clamp(g.ty+Math.sin(a)*r,AR.y1,AR.y2);G.delayed.push({t:.25+i*.12,fn:()=>G.explode(bx,by,85,g.dmg,400)});}
   }
  }
  G.grenades=G.grenades.filter(g=>!g.done);
  for(const d of G.delayed)d.t-=dt;
  for(const d of G.delayed)if(d.t<=0)d.fn();
  G.delayed=G.delayed.filter(d=>d.t>0);
  // bullets
  for(const b of G.bullets){
   const px=b.x,py=b.y;
   if(b.crescent)G.parts.push({x:b.x,y:b.y,vx:rand(-30,30),vy:rand(-30,30),t:.4,max:.4,col:Math.random()<.5?b.col:'#1a0509',size:rand(4,8)});
   if(b.friendly){
    if(b.home){let best=null,bd=1e9;for(const m of room.enemies){if(m.isDead()||m.spawnT>0)continue;const d=Math.hypot(m.x-b.x,m.y-b.y);if(d<bd){bd=d;best=m;}}
     if(best){const sp=Math.hypot(b.vx,b.vy);let ca=Math.atan2(b.vy,b.vx);ca+=clamp(angDiff(Math.atan2(best.y-b.y,best.x-b.x),ca),-4*dt,4*dt);b.vx=Math.cos(ca)*sp;b.vy=Math.sin(ca)*sp;}}
    if(b.boom&&!b.back&&b.life<=b.turn){b.back=true;b.hit.clear();}
    if(b.back){const dx=p.x-b.x,dy=p.y-b.y,d=Math.hypot(dx,dy)||1;b.vx=dx/d*700;b.vy=dy/d*700;b.life=Math.max(b.life,.1);if(d<22){b.life=0;continue;}}
    if(b.pull){for(const m of room.enemies){if(m.isDead()||m.spawnT>0||m.boss)continue;const dx=b.x-m.x,dy=b.y-m.y,d=Math.hypot(dx,dy);if(d<190&&d>6)step(m,dx/d*320,dy/d*320,dt);}}
    if(G.inZone('esmoke',b)){b.life=0;G.burst(b.x,b.y,4,'#8a96a0',80,.3,3);continue;}
   }
   b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;
   const blocked=(x,y)=>x<AR.x1||x>AR.x2||y<AR.y1||y>AR.y2||room.obstacles.some(o=>x>o.x&&x<o.x+o.w&&y>o.y&&y<o.y+o.h);
   if(!b.back&&blocked(b.x,b.y)){
    if(b.boom){b.back=true;b.hit.clear();}
    else if(b.bounce>0){b.bounce--;b.hit=new Set();
     if(!blocked(px,b.y)){b.x=px;b.vx=-b.vx;}else if(!blocked(b.x,py)){b.y=py;b.vy=-b.vy;}else{b.x=px;b.y=py;b.vx=-b.vx;b.vy=-b.vy;}
     G.burst(b.x,b.y,3,b.col,80,.2,2);}
    else{b.life=0;G.burst(b.x,b.y,3,b.col,80,.2,2);continue;}
   }
   if(b.friendly){
    for(const m of room.enemies){
     if(m.isDead()||m.spawnT>0||b.hit.has(m)||Math.hypot(m.x-b.x,m.y-b.y)>m.r+b.r)continue;
     b.hit.add(m);if(b.noHit)continue;m.takeDamage(b.dmg);if(b.slow)m.slowT=2.5;if(b.burn){m.burnT=3;m.burnD=b.burn;}G.afterHit(m,b.dmg,Math.atan2(b.vy,b.vx),b.boom?60:200);
     if(b.chain)G.chain(m,b);
     if(!b.pierce){b.life=0;break;}
    }
   }else{
    if(G.inZone('smoke',b)||G.inZone('fire',b)){b.life=0;G.burst(b.x,b.y,4,'#8a96a0',80,.3,3);continue;}
    if(Math.hypot(p.x-b.x,p.y-b.y)<p.r+b.r){b.life=0;G.hurtPlayer(b.dmg);}
   }
  }
  for(const b of G.bullets)if(b.life<=0&&b.explode)G.explode(b.x,b.y,b.explode,b.dmg);
  G.bullets=G.bullets.filter(b=>b.life>0);
  // room clear
  if(!G.cleared&&room.isCleared()){
   G.cleared=true;G.tickPowers();
   for(const t of room.giveReward(p))G.toast(t,'#72d283');
   
   if(G.roomIdx===G.rooms.length-1)G.terminal={x:820,y:300};
   G.toast(G.roomIdx===G.rooms.length-1?'Core Vault secured. Shut down the control system.':'Room cleared. The exit is open.','#f2b02e');sfx('clear');
  }
  // prompt
  G.prompt='';
  {const np=G.nearPickup();if(np)G.prompt='[E] Swap to '+np.weapon.name+' ('+np.weapon.rarity+')'+(np.weapon.o.tag?' - '+np.weapon.o.tag:'');}
  if(!G.prompt&&G.cleared){
   if(G.roomIdx<G.rooms.length-1){if(dist(p,DOOR)<95)G.prompt='[E] Descend to '+G.rooms[G.roomIdx+1].name;}
   else if(G.terminal&&dist(p,G.terminal)<75)G.prompt='[E] Shut down the control system';
  }
 },

 showEnd(){
  const won=G.state==='won';G.state='ended';const s=Math.floor(G.time);const mm=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
  const cleared=won?G.rooms.length:G.roomIdx;
  UI.overlay(won?'Core offline':'Run ended',
   won?'The control system is shut down. The machines have stopped moving.':'Signal lost in '+G.room.name+'. The machines are still running.',
   ['Rooms cleared '+cleared+'/'+G.rooms.length,'Machines destroyed '+G.kills,'Scrap '+G.p.inventory.scrap,'Time '+mm],
   ['Run again',()=>{UI.hide();G.startRun(G.key);}],['Scrapper select',UI.toMenu]);
 }
