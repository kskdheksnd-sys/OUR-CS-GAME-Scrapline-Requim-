  if(w.style==='swing'){
   G.fx.push({k:'swing',x:p.x,y:p.y,a:p.aim,r:w.range,half:w.arc,t:.14,max:.14,col:p.color});sfx('slash');
   for(const m of G.room.enemies){
    if(m.isDead()||m.spawnT>0||!w.isInRange(p,m))continue;
    const a=Math.atan2(m.y-p.y,m.x-p.x);
    if(Math.abs(angDiff(a,p.aim))<w.arc||dist(p,m)<m.r+22){const d=w.attack(p,m);G.afterHit(m,d,a,w.kb);if(w.o.leech)p.heal(d*w.o.leech);if(w.o.stun&&!m.boss&&!m.isDead())m.stun=Math.max(m.stun,w.o.stun);}
   }
