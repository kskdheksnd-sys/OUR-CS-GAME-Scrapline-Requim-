   }
   p.iframes=.35;for(const o of[-9,0,9])G.fx.push({k:'line',x:sx-Math.sin(p.aim)*o,y:sy+Math.cos(p.aim)*o,x2:p.x-Math.sin(p.aim)*o,y2:p.y+Math.cos(p.aim)*o,t:.3,max:.3,col:o?'#fff':p.color});G.burst(sx,sy,12,p.color,160,.4,3);
  }else if(A==='Nanite Field'){
   const t=G.aimPoint(p,260);G.zones.push({k:'heal',x:t.x,y:t.y,r:95,t:6,max:6,tick:0});G.fx.push({k:'ring',x:t.x,y:t.y,r:95,t:.4,max:.4,col:p.color});
  }else if(A==='Flame Wall'){
   const ax=Math.cos(p.aim),ay=Math.sin(p.aim),cx=p.x+ax*160,cy=p.y+ay*160;
   const X=v=>clamp(v,AR.x1+4,AR.x2-4),Y=v=>clamp(v,AR.y1+4,AR.y2-4);
   G.zones.push({k:'fire',x1:X(cx+ay*140),y1:Y(cy-ax*140),x2:X(cx-ay*140),y2:Y(cy+ax*140),w:16,t:5,max:5,tick:0});
  }else if(A==='Cluster Charge'){
   const t=G.aimPoint(p,420);G.grenades.push({x0:p.x,y0:p.y,x:p.x,y:p.y,tx:t.x,ty:t.y,t:0,dur:.55,dmg});
