/* ---------- model classes ---------- */
class GameEntity{
 constructor(name,hp,x=0,y=0){this.name=name;this.hp=hp;this.maxHp=hp;this.x=x;this.y=y;}
 takeDamage(d){this.hp=Math.max(0,this.hp-Math.round(d));}
 isDead(){return this.hp<=0;}
 move(nx,ny){this.x=nx;this.y=ny;}
}
class Item{
 constructor(name,effectType,amount,value){this.name=name;this.effectType=effectType;this.amount=amount;this.value=value;}
 use(user){
  if(this.effectType==='Heal')user.heal(this.amount);
  else if(this.effectType==='Shield')user.addShield(this.amount);
  else if(this.effectType==='Scrap')user.inventory.scrap+=this.amount;
 }
}
class PowerUp{
 constructor(name,affectedStat,bonus,durationRooms){this.name=name;this.affectedStat=affectedStat;this.bonus=bonus;this.durationRooms=durationRooms;}
 apply(u){
  if(this.affectedStat==='Attack')u.atkBonus+=this.bonus;
  else if(this.affectedStat==='Speed')u.speedBonus+=this.bonus;
  else if(this.affectedStat==='Max HP'){u.maxHp+=this.bonus;u.hp+=this.bonus;}
 }
 remove(u){
  if(this.affectedStat==='Attack')u.atkBonus-=this.bonus;
  else if(this.affectedStat==='Speed')u.speedBonus-=this.bonus;
  else if(this.affectedStat==='Max HP'){u.maxHp-=this.bonus;u.hp=Math.min(u.hp,u.maxHp);}
 }
}
class Weapon{
 constructor(name,baseAtk,type,rarity,range,cooldown,style='bolt',o={}){
  this.name=name;this.baseAtk=baseAtk;this.type=type;this.rarity=rarity;this.range=range;this.cooldown=cooldown;this.style=style;
  this.o=o;this.mult=o.mult||1;this.pellets=o.pellets||1;this.spread=o.spread||0;this.arc=o.arc||1.2;this.kb=o.kb||360;this.radius=o.radius||0;
 }
 calculateDamage(user){return Math.round((this.baseAtk+user.atk+user.atkBonus)*this.mult);}
 attack(user,target){const d=this.calculateDamage(user);target.takeDamage(d);return d;}
 isInRange(user,target){return Math.hypot(user.x-target.x,user.y-target.y)<=this.range+(target.r||0);}
}
class Inventory{
 constructor(items,capacity,scrap){this.items=items;this.capacity=capacity;this.scrap=scrap;}
 addItem(item){if(this.items.length>=this.capacity)return false;this.items.push(item);return true;}
 removeItem(item){const i=this.items.indexOf(item);if(i>=0)this.items.splice(i,1);}
 useItem(item,user){item.use(user);this.removeItem(item);}
}
class Scrapper extends GameEntity{
 constructor(name,hp,atk,ability,inventory,color,abilityMax){
  super(name,hp,86,300);
  this.atk=atk;this.ability=ability;this.inventory=inventory;this.color=color;
  this.atkBonus=0;this.speed=5;this.speedBonus=0;this.r=14;
  this.shield=0;this.shieldMax=300;this.weapon=null;this.weapon2=null;
  this.aim=0;this.atkCd=0;this.abilityCd=0;this.abilityMax=abilityMax;
  this.dashT=0;this.dashCd=0;this.dashX=1;this.dashY=0;this.iframes=0;this.rapidT=0;this.hurtT=0;this.selected=0;
 }
