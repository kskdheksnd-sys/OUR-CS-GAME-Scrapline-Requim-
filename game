 },
 fire(){
  const p=G.p,w=p.weapon;p.atkCd=w.cooldown*(p.rapidT>0?.35:1);
  const ax=Math.cos(p.aim),ay=Math.sin(p.aim),dmg=w.calculateDamage(p),mx=p.x+ax*22,my=p.y+ay*22;
