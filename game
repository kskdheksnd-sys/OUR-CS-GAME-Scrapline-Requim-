function render(t){
  if(!G.p||!G.room)return;
  ctx.setTransform(DPR,0,0,DPR,0,0);
  ctx.save();
  if(G.shake>0)ctx.translate(rand(-G.shake,G.shake)*.5,rand(-G.shake,G.shake)*.5);
  drawFloor();drawPickups();drawTelegraphs();drawBankai(t);
  for(const m of G.room.enemies)drawMachine(m,t);
  drawPlayer();drawGadgets();drawZones(t);drawFx();
  ctx.restore();
  drawHUD();
  if(G.card>0&&G.state!=='dead'){
    const a=clamp(G.card,0,1);ctx.globalAlpha=a;
    ctx.fillStyle='rgba(11,14,16,.7)';ctx.fillRect(0,230,W,120);ctx.fillStyle='#f2b02e';ctx.fillRect(0,230,W,3);ctx.fillRect(0,347,W,3);
    txt('ROOM '+(G.roomIdx+1)+' · '+G.room.roomType.toUpperCase(),W/2,266,13,'#f2b02e','center',MONO,600);
    txt(G.room.name.toUpperCase(),W/2,322,56,'#dde4e8','center',DISP,900);
    ctx.globalAlpha=1;
  }
  if(G.flash>0){ctx.fillStyle=G.state==='won'?`rgba(255,255,255,${G.flash*.6})`:`rgba(255,60,40,${G.flash*.25})`;ctx.fillRect(0,0,W,H);}
  if(G.trans){const a=G.trans.phase==='out'?G.trans.t:1-G.trans.t;ctx.fillStyle=`rgba(8,10,12,${clamp(a,0,1)})`;ctx.fillRect(0,0,W,H);}
  drawCine();
  // crosshair
  if(G.state==='play'||G.state==='trans'){
    const m=G.mouse;ctx.strokeStyle='#f2b02e';ctx.lineWidth=2;ctx.beginPath();ctx.arc(m.x,m.y,9,0,7);ctx.moveTo(m.x-15,m.y);ctx.lineTo(m.x-5,m.y);ctx.moveTo(m.x+5,m.y);ctx.lineTo(m.x+15,m.y);ctx.moveTo(m.x,m.y-15);ctx.lineTo(m.x,m.y-5);ctx.moveTo(m.x,m.y+5);ctx.lineTo(m.x,m.y+15);ctx.stroke();
  }
}
})();
